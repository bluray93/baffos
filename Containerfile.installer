FROM localhost/baffos:latest

# Utente live
RUN useradd -m -G wheel live \
    && echo 'live:live' | chpasswd \
    && echo 'live ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/live \
    && chmod 0440 /etc/sudoers.d/live

# Config installer
RUN mkdir -p /etc/bootc-installer

COPY installer/images.json /etc/bootc-installer/images.json
COPY installer/recipe.json /etc/bootc-installer/recipe.json

RUN touch /etc/bootc-installer/live-iso-mode

# Installazione bootc-installer Flatpak
RUN curl -L \
    -o /tmp/installer.flatpak \
    https://github.com/tuna-os/tuna-installer/releases/download/continuous/org.bootcinstaller.Installer.flatpak \
    && flatpak install --system --noninteractive --bundle /tmp/installer.flatpak \
    && rm -f /tmp/installer.flatpak

RUN flatpak override --system \
    --env=BOOTC_CUSTOM_RECIPE=/run/host/etc/bootc-installer/recipe.json \
    org.bootcinstaller.Installer
